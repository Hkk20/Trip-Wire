NODE_ENV=development
PORT=8080
# Leave blank to serve the bundled Frontend from this API. Set only for a separate UI origin.
FRONTEND_ORIGIN=
# Set true only when a trusted reverse proxy terminates HTTPS in front of the API.
TRUST_PROXY=false

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# GitHub fine-grained PAT: read access to Pull requests and Contents for the target repo.
GITHUB_TOKEN=github_pat_replace_me

# Optional: without this, deterministic local secret checks still work and no diff goes to an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Demo-only identity used by the static prototype. This endpoint is unavailable in production.
DEMO_USER=demo-reviewer
